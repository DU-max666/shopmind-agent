# ================= 智铺 ShopMind 环境变量示例 =================
# 全部为占位符，复制为 .env 后填写。留空时系统自动降级为离线 Mock 模式，可无密钥跑通单测与评测。

# --- 服务鉴权与限流 ---
SHOPMIND_API_KEY=sk-shopmind-请替换为随机密钥
SHOPMIND_RATE_QPS=5
SHOPMIND_DEBUG=true

# --- LLM（OpenAI 兼容接口，留空则使用离线 MockLLM）---
LLM_BASE_URL=https://your-llm-gateway.example.com/v1
LLM_API_KEY=sk-请替换
LLM_MODEL=请替换为私有化部署的模型名
LLM_TIMEOUT_S=30

# --- 数据库 / 缓存 / 向量库 ---
MYSQL_DSN=mysql+pymysql://shopmind:请替换@mysql:3306/shopmind?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=shopmind_kb

# --- 安全阈值（可选，覆盖默认值）---
AUTO_REFUND_MAX=50
SANDBOX_REFUND_MAX=200
GROUNDED_MIN_RATIO=0.8
ROUTE_ANSWER_THRESHOLD=0.75
ROUTE_CLARIFY_THRESHOLD=0.55
